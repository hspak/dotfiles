gtk-tabs-location = bottom

font-family = Iosevka Serif
font-size = 11

keybind = ctrl+alt+l=goto_split:right
keybind = ctrl+alt+h=goto_split:left
keybind = alt+d=new_split:right

window-decoration = server
unfocused-split-opacity = 1

